# 复制为 deploy/backend.env，权限 600。不要提交真实口令、主密钥或模型 Key。
AGENT_WORKSTATION_SERVE_MODE=hosted
AGENT_WORKSTATION_AUTH_EMAIL_MODE=smtp
AGENT_WORKSTATION_SMTP_HOST=
AGENT_WORKSTATION_SMTP_PORT=587
AGENT_WORKSTATION_SMTP_USERNAME=
AGENT_WORKSTATION_SMTP_PASSWORD=
AGENT_WORKSTATION_SMTP_FROM=
AGENT_WORKSTATION_ADMIN_EMAILS=
AGENT_WORKSTATION_DATA_DIR=/srv/yinli/data

# 托管必填。Fernet key：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_WORKSTATION_SECRET_KEY=
# 与 key2api 的 YINLI_SYNC_TOKEN 相同。托管缺少它会拒绝启动。
AGENT_WORKSTATION_KEY2API_SYNC_TOKEN=
AGENT_WORKSTATION_KEY2API_BASE_URL=http://103.236.80.228:3000

# 方案 A：本机 Docker。daemon 看到的数据根必须和容器内 DATA_DIR 相同。
AGENT_WORKSTATION_SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
AGENT_WORKSTATION_SANDBOX_HOST_DATA_ROOT=/srv/yinli/data
AGENT_WORKSTATION_SANDBOX_RUNTIME=runsc
AGENT_WORKSTATION_SANDBOX_ALLOW_RUNC=false
AGENT_WORKSTATION_SANDBOX_NETWORK=yinli-sandbox
AGENT_WORKSTATION_SANDBOX_IMAGES=python:3.11-slim
AGENT_WORKSTATION_SANDBOX_MEMORY_MB=1024
AGENT_WORKSTATION_SANDBOX_CPUS=1.0
AGENT_WORKSTATION_SANDBOX_PIDS=256
AGENT_WORKSTATION_SANDBOX_MAX_TIMEOUT_SECONDS=600
# 方案 B：独立沙箱主机。改成 tcp://sandbox-host:2376，并填写下面三个证书路径。
AGENT_WORKSTATION_SANDBOX_TLS_CA=
AGENT_WORKSTATION_SANDBOX_TLS_CERT=
AGENT_WORKSTATION_SANDBOX_TLS_KEY=

# 租户配额。只在 hosted 生效。
AGENT_WORKSTATION_TENANT_DISK_MB=2048
AGENT_WORKSTATION_TENANT_UPLOAD_MB=50
AGENT_WORKSTATION_TENANT_MAX_ACTIVE_RUNS=3
AGENT_WORKSTATION_TENANT_MAX_JOBS=20
AGENT_WORKSTATION_TENANT_MAX_FIRINGS_PER_DAY=50

# 逗号分隔。允许用户模型或 MCP 指向这些主机，例如内网 key2api。平台网关本身不走这道校验。
AGENT_WORKSTATION_EGRESS_ALLOW_HOSTS=
