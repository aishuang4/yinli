{
  "name": "frontend",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "YINLI local-first AI workstation for office work",
  "author": "YINLI",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:compile": "tsc -p ../electron/tsconfig.json && node ../scripts/build-macos-qlpreview.mjs && node ../scripts/prepare-electron-dist.mjs",
    "release:preflight": "node ../scripts/release-preflight.mjs",
    "electron:dev": "../scripts/electron-dev.sh",
    "electron:dev:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/debug-windows-source.ps1",
    "electron:dev:win:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/debug-windows-source.ps1 -InstallDependencies",
    "electron:pack": "node ../scripts/electron-package.mjs",
    "electron:build:mac": "node ../scripts/electron-package.mjs mac",
    "electron:build:win": "node ../scripts/electron-package.mjs win"
  },
  "dependencies": {
    "@agentscope-ai/chat": "^1.1.67",
    "@agentscope-ai/design": "^1.0.32",
    "@ant-design/x-markdown": "^2.7.0",
    "antd": "^5.29.3",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.17.0",
    "node-addon-api": "^8.9.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "uuid": "^11.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "42.3.3",
    "electron-builder": "^26.15.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "node-gyp": "^11.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.0"
  }
}
