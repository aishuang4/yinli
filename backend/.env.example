# Agent Workstation 后端配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API Key（从 https://platform.deepseek.com/ 获取）
AGENT_WORKSTATION_DEEPSEEK_API_KEY=your_deepseek_api_key_here
AGENT_WORKSTATION_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 百炼 DashScope API Key（可选，从 https://dashscope.console.aliyun.com/ 获取）
AGENT_WORKSTATION_DASHSCOPE_API_KEY=

# 默认模型
AGENT_WORKSTATION_DEFAULT_MODEL=deepseek-v4-flash
AGENT_WORKSTATION_FALLBACK_MODELS='["deepseek-v4-pro"]'

# 本地或私有 OpenAI 兼容模型不用写在 .env，建议在系统设置里选择“自定义 OpenAI 兼容”，
# 填入 Base URL（例如 http://127.0.0.1:8000/v1）和模型 ID。

# 服务监听地址和端口。桌面后端只允许本机访问，不要改为 0.0.0.0。
AGENT_WORKSTATION_HOST=127.0.0.1
AGENT_WORKSTATION_PORT=8765

# 服务模式。desktop 为本机工作台；hosted 要求登录。托管发信可用 log 把验证码打到日志。
# AGENT_WORKSTATION_SERVE_MODE=hosted
# AGENT_WORKSTATION_ADMIN_EMAILS=admin@yinli.test
# 未设置时，托管模式会创建 admin@yinli.test，初始密码为 yinli-admin。已存在账号不会被改密码。
# AGENT_WORKSTATION_ADMIN_INITIAL_PASSWORD=
# AGENT_WORKSTATION_AUTH_EMAIL_MODE=log
# AGENT_WORKSTATION_SMTP_HOST=
# AGENT_WORKSTATION_SMTP_PORT=587
# AGENT_WORKSTATION_SMTP_USERNAME=
# AGENT_WORKSTATION_SMTP_PASSWORD=
# AGENT_WORKSTATION_SMTP_FROM=
# 托管用户的平台模型。地址默认是已发布的 key2api，令牌与 key2api 的 YINLI_SYNC_TOKEN 相同。
# 未设置令牌时，平台模型仍来自本机 models.json。
# AGENT_WORKSTATION_KEY2API_BASE_URL=http://103.236.80.228:3000
# AGENT_WORKSTATION_KEY2API_SYNC_TOKEN=
# 桌面端登录云端的地址写在 config/desktop.json，打包时打进安装包。这里只在需要覆盖时填写。
# AGENT_WORKSTATION_CLOUD_BASE_URL=

# 向量存储。不进 Settings，由 VectorStorePolicy 首次初始化时读取；初始化后需显式迁移才能切换。
VECTOR_STORE_PROVIDER=zvec

# Embedding 默认禁用：向量库使用标量过滤 + BM25 / 稀疏检索降级。
EMBEDDING_PROVIDER=disabled
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSIONS=1536
